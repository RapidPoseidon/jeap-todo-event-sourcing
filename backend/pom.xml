<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <version>41.2.0</version>
        <relativePath/>
    </parent>

    <groupId>ch.example.todo</groupId>
    <artifactId>todo-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>todo-backend</name>
    <description>Event-sourced todo backend built on jEAP building blocks</description>

    <modules>
        <module>todo-eventsourcing-core</module>
        <module>todo-task-service</module>
        <module>todo-oauth-mock-server</module>
    </modules>

    <properties>
        <jeap-oauth-mock-server.version>11.0.0</jeap-oauth-mock-server.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>ch.example.todo</groupId>
                <artifactId>todo-eventsourcing-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Not managed by jeap-spring-boot-parent: the mock server is a standalone jEAP product. -->
            <dependency>
                <groupId>ch.admin.bit.jeap</groupId>
                <artifactId>jeap-oauth-mock-server</artifactId>
                <version>${jeap-oauth-mock-server.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
